---
import SeoHead from './SeoHead.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
}

const { title, description, path = '/' } = Astro.props;

const navLinks = [
  { href: '/#how-it-works', label: 'How it works' },
  { href: '/#features', label: 'Features' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/guides', label: 'Guides' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <SeoHead title={title} description={description} path={path} />
  </head>
  <body class="flex min-h-screen flex-col bg-white text-ink-900 dark:bg-ink-950 dark:text-ink-100">
    <header class="sticky top-0 z-40 border-b border-ink-100 bg-white/80 backdrop-blur-md dark:border-ink-800 dark:bg-ink-950/80">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
        <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
          <img src="/favicon.svg" alt="" width="28" height="28" class="rounded-lg" />
          <span>Bookmark Intelligence</span>
        </a>
        <nav class="hidden items-center gap-8 text-sm font-medium text-ink-600 md:flex dark:text-ink-300">
          {navLinks.map((link) => (
            <a href={link.href} class="transition hover:text-ink-950 dark:hover:text-white">{link.label}</a>
          ))}
        </nav>
        <div class="flex items-center gap-3">
          <a
            href="/app?demo=1"
            class="hidden text-sm font-medium text-ink-600 transition hover:text-ink-950 sm:inline dark:text-ink-300 dark:hover:text-white"
          >
            Try Demo
          </a>
          <a
            href="/app"
            class="rounded-full bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm shadow-brand-600/30 transition hover:bg-brand-700"
          >
            Open App
          </a>
        </div>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-ink-100 bg-ink-50/60 dark:border-ink-800 dark:bg-ink-900/40">
      <div class="mx-auto max-w-6xl px-6 py-12">
        <div class="grid gap-10 sm:grid-cols-2 md:grid-cols-4">
          <div>
            <div class="flex items-center gap-2 font-semibold">
              <img src="/favicon.svg" alt="" width="24" height="24" class="rounded-lg" />
              Bookmark Intelligence
            </div>
            <p class="mt-3 text-sm text-ink-500 dark:text-ink-400">
              100% local processing. Your bookmarks never leave your device.
            </p>
          </div>
          <div>
            <p class="text-sm font-semibold text-ink-900 dark:text-white">Product</p>
            <ul class="mt-3 space-y-2 text-sm text-ink-500 dark:text-ink-400">
              <li><a href="/#features" class="hover:text-ink-900 dark:hover:text-white">Features</a></li>
              <li><a href="/app" class="hover:text-ink-900 dark:hover:text-white">Open App</a></li>
              <li><a href="/app?demo=1" class="hover:text-ink-900 dark:hover:text-white">Try Demo</a></li>
            </ul>
          </div>
          <div>
            <p class="text-sm font-semibold text-ink-900 dark:text-white">Learn</p>
            <ul class="mt-3 space-y-2 text-sm text-ink-500 dark:text-ink-400">
              <li><a href="/bookmark-organizer" class="hover:text-ink-900 dark:hover:text-white">Bookmark Organizer</a></li>
              <li><a href="/duplicate-bookmark-finder" class="hover:text-ink-900 dark:hover:text-white">Duplicate Finder</a></li>
              <li><a href="/bookmark-cleaner" class="hover:text-ink-900 dark:hover:text-white">Bookmark Cleaner</a></li>
              <li><a href="/guides" class="hover:text-ink-900 dark:hover:text-white">Guides</a></li>
            </ul>
          </div>
          <div>
            <p class="text-sm font-semibold text-ink-900 dark:text-white">Company</p>
            <ul class="mt-3 space-y-2 text-sm text-ink-500 dark:text-ink-400">
              <li><a href="/privacy" class="hover:text-ink-900 dark:hover:text-white">Privacy Center</a></li>
              <li><a href="https://github.com/ChinmayShastry/bookmark-intelligence" class="hover:text-ink-900 dark:hover:text-white">Source on GitHub</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-ink-200 pt-6 text-xs text-ink-400 sm:flex-row dark:border-ink-800">
          <p>&copy; {new Date().getFullYear()} Bookmark Intelligence. No account. No uploads. No AI API.</p>
          <p>Built with Astro, React &amp; IndexedDB.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
