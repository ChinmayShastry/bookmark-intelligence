---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import {
  Upload,
  Sparkles,
  Search,
  BarChart3,
  RotateCcw,
  Lock,
  FolderTree,
  Copy,
  Tag,
  Download,
} from 'lucide-react';

const MESSY = [
  { label: '127 AI articles', rotate: '-rotate-2' },
  { label: '84 YouTube videos', rotate: 'rotate-1' },
  { label: '63 tools', rotate: '-rotate-1' },
  { label: '41 job resources', rotate: 'rotate-2' },
  { label: '29 finance links', rotate: '-rotate-1' },
  { label: '18 random links', rotate: 'rotate-1' },
];

const ORGANIZED = [
  'AI', 'Development', 'Finance', 'Career', 'Design',
  'Business', 'Learning', 'Tools', 'Research', 'Personal',
];

const CAPABILITIES = [
  {
    icon: Upload,
    title: 'Import',
    body: 'Drop in your exported bookmark HTML file from Chrome, Edge, Firefox, Brave, or Safari. Parsed instantly, entirely on your device.',
  },
  {
    icon: FolderTree,
    title: 'Organize',
    body: 'A deterministic classifier reads each bookmark’s domain, title, and folder to suggest categories and tags — no AI API involved.',
  },
  {
    icon: Search,
    title: 'Search',
    body: 'Fuzzy, instant search across titles, URLs, tags, and notes, plus operators like tag:ai, domain:github.com, and smart keywords like "duplicates".',
  },
  {
    icon: BarChart3,
    title: 'Analyze',
    body: 'A transparent Bookmark Health score, category breakdowns, growth charts, and a duplicate finder you can actually act on.',
  },
  {
    icon: RotateCcw,
    title: 'Rediscover',
    body: 'Forgotten bookmarks resurface with a one-click Still useful / Archive / Delete flow — so nothing valuable stays buried forever.',
  },
];

const STEPS = [
  'Messy bookmarks',
  'Import',
  'Automatic organization',
  'Intelligent search',
  'Insights',
  'Cleanup & discovery',
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Bookmark Intelligence',
  applicationCategory: 'BrowserApplication',
  operatingSystem: 'Any (runs in the browser)',
  description:
    'Bookmark Intelligence turns thousands of scattered browser bookmarks into a searchable, organized personal knowledge base, entirely on-device with no account, uploads, or AI API.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---
<MarketingLayout
  title="Bookmark Intelligence — Turn bookmark chaos into organized knowledge"
  description="Bookmark Intelligence organizes your browser bookmarks into a searchable, structured personal knowledge base — entirely on your device. No account, no uploads, no AI API, no cloud database."
  path="/"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-6 pb-8 pt-16 text-center sm:pt-24">
    <h1 class="mx-auto max-w-3xl text-4xl font-bold tracking-tight text-ink-950 sm:text-5xl dark:text-white">
      Your bookmarks are more valuable than you think.
    </h1>
    <p class="mx-auto mt-5 max-w-xl text-lg text-ink-600 dark:text-ink-300">
      Bookmark Intelligence turns thousands of scattered bookmarks into a searchable, organized personal
      knowledge base — entirely in your browser.
    </p>
    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href="/app"
        class="rounded-full bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-600/25 transition hover:bg-brand-700"
      >
        Import My Bookmarks
      </a>
      <a
        href="#how-it-works"
        class="rounded-full border border-ink-200 px-6 py-3 text-sm font-semibold text-ink-700 transition hover:bg-ink-50 dark:border-ink-700 dark:text-ink-200 dark:hover:bg-ink-800"
      >
        See How It Works
      </a>
    </div>
    <p class="mt-5 flex items-center justify-center gap-1.5 text-xs font-medium text-ink-500 dark:text-ink-400">
      <Lock size={13} aria-hidden="true" />
      100% local processing. Your bookmarks never leave your device.
    </p>
  </section>

  <!-- Hero visual: messy -> organized -->
  <section class="mx-auto max-w-5xl px-6 pb-20">
    <div class="grid items-center gap-8 rounded-3xl border border-ink-100 bg-ink-50/60 p-8 sm:p-10 md:grid-cols-[1fr_auto_1fr] dark:border-ink-800 dark:bg-ink-900/40">
      <div>
        <p class="mb-3 text-center text-xs font-semibold uppercase tracking-wide text-ink-400 md:text-left">
          Messy bookmarks
        </p>
        <div class="space-y-2">
          {MESSY.map((item) => (
            <div class={`w-fit rounded-lg border border-ink-200 bg-white px-3 py-1.5 text-sm text-ink-600 shadow-sm ${item.rotate} dark:border-ink-700 dark:bg-ink-800 dark:text-ink-300`}>
              {item.label}
            </div>
          ))}
        </div>
      </div>

      <div class="flex justify-center">
        <div class="h-10 w-10 rotate-90 text-brand-400 md:rotate-0 animate-flow">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </div>
      </div>

      <div>
        <p class="mb-3 text-center text-xs font-semibold uppercase tracking-wide text-brand-600 dark:text-brand-400 md:text-left">
          Bookmark Intelligence
        </p>
        <div class="grid grid-cols-2 gap-2">
          {ORGANIZED.map((name) => (
            <div class="rounded-lg border border-brand-200 bg-white px-3 py-1.5 text-center text-sm font-medium text-brand-700 dark:border-brand-500/30 dark:bg-ink-800 dark:text-brand-300">
              {name}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="how-it-works" class="border-t border-ink-100 bg-white py-20 dark:border-ink-800 dark:bg-ink-950">
    <div class="mx-auto max-w-5xl px-6">
      <h2 class="text-center text-2xl font-semibold text-ink-900 dark:text-white">How it works</h2>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        {STEPS.map((step, i) => (
          <>
            <span class="rounded-full border border-ink-200 bg-ink-50 px-4 py-2 text-sm font-medium text-ink-700 dark:border-ink-700 dark:bg-ink-900 dark:text-ink-200">
              {step}
            </span>
            {i < STEPS.length - 1 && <span class="text-ink-300 dark:text-ink-700">&rarr;</span>}
          </>
        ))}
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section id="features" class="border-t border-ink-100 bg-ink-50/50 py-20 dark:border-ink-800 dark:bg-ink-900/30">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="text-center text-2xl font-semibold text-ink-900 dark:text-white">Five things it actually does</h2>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
        {CAPABILITIES.map((cap) => (
          <div class="rounded-2xl border border-ink-100 bg-white p-5 dark:border-ink-800 dark:bg-ink-900">
            <cap.icon size={20} className="text-brand-600 dark:text-brand-400" aria-hidden="true" />
            <h3 class="mt-3 text-sm font-semibold text-ink-900 dark:text-white">{cap.title}</h3>
            <p class="mt-1.5 text-xs leading-relaxed text-ink-500 dark:text-ink-400">{cap.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Before / After -->
  <section class="border-t border-ink-100 bg-white py-20 dark:border-ink-800 dark:bg-ink-950">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="text-center text-2xl font-semibold text-ink-900 dark:text-white">The transformation is obvious</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        <div class="rounded-2xl border border-ink-200 p-6 dark:border-ink-700">
          <p class="text-xs font-semibold uppercase tracking-wide text-ink-400">Before</p>
          <ul class="mt-3 space-y-2 text-sm text-ink-600 dark:text-ink-300">
            <li>2,481 bookmarks</li>
            <li>18 folders</li>
            <li>Random stuff everywhere</li>
            <li>Can't find anything</li>
          </ul>
        </div>
        <div class="rounded-2xl border border-brand-200 bg-brand-50/50 p-6 dark:border-brand-500/30 dark:bg-brand-500/10">
          <p class="text-xs font-semibold uppercase tracking-wide text-brand-600 dark:text-brand-400">After</p>
          <ul class="mt-3 space-y-1.5 text-sm text-ink-700 dark:text-ink-200">
            <li class="flex justify-between"><span>AI</span><span class="font-semibold">412</span></li>
            <li class="flex justify-between"><span>Development</span><span class="font-semibold">387</span></li>
            <li class="flex justify-between"><span>Finance</span><span class="font-semibold">241</span></li>
            <li class="flex justify-between"><span>Duplicates found</span><span class="font-semibold">143</span></li>
            <li class="flex justify-between"><span>Forgotten surfaced</span><span class="font-semibold">642</span></li>
          </ul>
          <p class="mt-3 rounded-lg bg-white px-3 py-2 font-mono text-xs text-ink-600 dark:bg-ink-900 dark:text-ink-300">
            search: "rag github" &rarr; instant results
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Privacy banner -->
  <section class="border-t border-ink-100 bg-ink-950 py-16 text-white dark:border-ink-800">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <Lock size={22} className="mx-auto text-brand-400" aria-hidden="true" />
      <h2 class="mt-3 text-xl font-semibold">No account. No uploads. No AI API. No cloud database.</h2>
      <p class="mt-2 text-sm text-ink-300">
        Just your bookmarks, organized on your device. Read exactly what that means on the
        <a href="/privacy" class="underline underline-offset-2 hover:text-white">Privacy Center</a>.
      </p>
    </div>
  </section>

  <!-- Plan -->
  <section class="border-t border-ink-100 bg-white py-20 dark:border-ink-800 dark:bg-ink-950">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="text-2xl font-semibold text-ink-900 dark:text-white">Free, and genuinely useful</h2>
      <p class="mt-2 text-sm text-ink-500 dark:text-ink-400">
        Every feature in this product is free today: unlimited local bookmarks, import, search, categories, tags,
        duplicate detection, insights, and export.
      </p>
      <div class="mx-auto mt-8 max-w-sm rounded-2xl border border-ink-200 p-6 text-left dark:border-ink-700">
        <p class="text-sm font-semibold text-ink-900 dark:text-white">Free — forever</p>
        <ul class="mt-3 space-y-2 text-sm text-ink-600 dark:text-ink-300">
          {[
            [FolderTree, 'Unlimited local bookmarks'],
            [Search, 'Fuzzy + operator search'],
            [Tag, 'Categories & tags'],
            [Copy, 'Duplicate detection'],
            [BarChart3, 'Insights & health score'],
            [Download, 'Export anytime, any format'],
          ].map(([Icon, label]) => (
            <li class="flex items-center gap-2">
              <Icon size={15} className="text-emerald-500" aria-hidden="true" />
              {label}
            </li>
          ))}
        </ul>
      </div>
      <p class="mx-auto mt-6 max-w-md text-xs text-ink-400">
        Ideas like cross-device sync or a browser extension may become an optional paid tier later — nothing
        like that exists in the product today, and the free tier will always stay this capable.
      </p>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="border-t border-ink-100 bg-ink-50/60 py-20 text-center dark:border-ink-800 dark:bg-ink-900/30">
    <Sparkles size={24} className="mx-auto text-brand-600 dark:text-brand-400" aria-hidden="true" />
    <h2 class="mx-auto mt-3 max-w-lg text-2xl font-semibold text-ink-900 dark:text-white">
      Your bookmarks are a knowledge base. You just can't search them properly — yet.
    </h2>
    <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href="/app"
        class="rounded-full bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-600/25 transition hover:bg-brand-700"
      >
        Organize My Bookmarks
      </a>
      <a
        href="/app?demo=1"
        class="rounded-full border border-ink-200 px-6 py-3 text-sm font-semibold text-ink-700 transition hover:bg-ink-50 dark:border-ink-700 dark:text-ink-200 dark:hover:bg-ink-800"
      >
        Try Demo
      </a>
    </div>
  </section>
</MarketingLayout>
